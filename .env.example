# D-Wave Quantum Annealing Configuration
# Copy this file to .env and fill in your actual values

# D-Wave API Token (required for QPU access)
# Get your token from: https://cloud.dwavesys.com/leap/
DWAVE_API_TOKEN=your-dwave-api-token-here

# D-Wave API Key (deprecated, use DWAVE_API_TOKEN instead)
DWAVE_API_KEY=your-dwave-api-token-here

# D-Wave Solver Name (default: Advantage2_system1.6)
# Available solvers: Advantage_system4.1, Advantage2_system1.6, etc.
# Check available solvers: https://cloud.dwavesys.com/leap/
DWAVE_API_SOLVER=Advantage2_system1.6

# D-Wave Region URL (default: https://cloud.dwavesys.com/sapi/v2)
DWAVE_REGION_URL=https://cloud.dwavesys.com/sapi/v2
